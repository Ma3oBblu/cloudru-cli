# Конфигурация CLI и Terraform. Никаких значений в репозитории.
# Скопируйте в ~/.config/cloudru/env (chmod 600) или экспортируйте руками.

# Ключ доступа сервисного аккаунта Cloud.ru:
# консоль → проект → Пользователи → Сервисные аккаунты → Ключи доступа
export CLOUDRU_KEY_ID='<Key ID>'
export CLOUDRU_SECRET='<Key Secret>'

# UUID проекта Evolution
export CLOUDRU_PROJECT_ID='<UUID>'

# Для Terraform: пароль прикладного пользователя БД
export TF_VAR_pg_password='<16+ символов>'
